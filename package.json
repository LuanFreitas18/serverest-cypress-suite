{
  "name": "serverest-cypress-suite",
  "version": "1.0.0",
  "description": "E2E and API automation suite for ServeRest using Cypress",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:e2e": "cypress run --spec 'cypress/e2e/frontend/**/*.cy.js'",
    "cy:run:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.js'"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "cypress": "^16.1.0"
  }
}